{
  "manifest_version": 3,
  "name": "CC Browser Helper",
  "version": "0.3.18",
  "description": "Browser helper for CC — Comment Collection. Collects public comments from supported sites, including Instagram and Pikabu, via the current browser session.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://greenn.github.io/cc/*",
    "https://*.nadube.ru/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://pikabu.ru/*",
    "https://www.pikabu.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://greenn.github.io/cc/*",
        "https://*.nadube.ru/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "cc-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "instagram-network-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "instagram-network-collector.js",
        "instagram-dom-pruner.js",
        "instagram-scraper.js",
        "instagram-media.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pikabu.ru/*",
        "https://www.pikabu.ru/*"
      ],
      "js": [
        "pikabu-scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CC Browser Helper — ON"
  }
}
